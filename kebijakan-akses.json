      "nama": "Buat repo privat baru (Persetujuan Rilis proyek baru)",
      "jabatan": ["coo"]
    }
  },

  "penyedia": {
    "github": {
      "jenis": "cli", "perintah": "gh", "kemampuan": "repo",
      "baca": [
        "^(run|pr|issue|release|workflow|repo|cache|ruleset|label)\\s+(list|view|watch|checks|status|diff)\\b",
        "^auth\\s+status\\b",
        "^search\\s",
        "^(--version|version)\\b"
      ],
      "api_baca": true,
      "repo_buat_privat": "^repo\\s+create\\s+\\S+(?=.*\\s--private\\b)(?!.*--public)(?!.*--push)(?!.*--internal)(?!.*--private=)(?!.*--visibility)",
      "akun": "pribadi pemilik — tahap berikut: akun/token khusus RudisOne"
    },
    "gitlab": {
      "jenis": "cli", "perintah": "glab", "kemampuan": "repo", "status": "siap dipakai bila ada proyek GitLab",
      "baca": [
        "^(mr|issue|release|ci|pipeline|repo)\\s+(list|view|status|diff)\\b",
        "^auth\\s+status\\b"
      ],
      "api_baca": true,
      "repo_buat_privat": "^repo\\s+create\\s+\\S+(?=.*\\s--private\\b)(?!.*--public)(?!.*--push)(?!.*--internal)(?!.*--private=)(?!.*--visibility)",
      "akun": "belum ada"
    },
    "git": { "jenis": "cli", "perintah": "git", "kemampuan": "repo", "tulis_remote": "^push\\b" }
  },

  "keterangan_konfigurasi": "Host ssh (jenis ssh, kemampuan server), daftar aplikasi deploy jenjang 2, dan MCP DNS yang aktif berasal dari konfigurasi/server.json: server.<alias>.ssh_host · aplikasi.<slug>.{server,folder,repo} · dns.mcp_server (harus punya adapter di adapter_mcp).",

  "adapter_mcp": {
    "hostinger-api": {
      "klasifikasi": "operasi",
      "kemampuan_menurut_awalan": { "dns_": "dns", "domains_": "dns", "vps_": "server", "*": "hosting" },
      "baca_operasi": "(^|[_-])(list|get|validate|status|show|search|check|availability|catalog)$",
      "dns_tambah_operasi": "dns_records_update"
    }
  },

  "perkakas_baca": {
    "server-cek": "server",
    "pasca-deploy": "server",
    "rilis-cek": "rilis"
  },
  "perkakas_perintah": {
    "perkakas": { "pastikan": "skill-luar", "skill": "skill-luar" }
  },

  "ssh_baca": [
    "^(uptime|df|free|whoami|hostname|date|uname|id|nproc)\\b",
    "^ls\\b",
    "^(cat|head|tail|grep|wc|stat|find)\\b",
    "^docker\\s+(ps|images|logs|inspect|stats\\s+--no-stream|version|info|system\\s+df)\\b",
    "^docker\\s+compose\\s+(ps|logs|images|ls)\\b",
    "^systemctl\\s+(status|is-active|is-enabled|list-units|list-timers)\\b",
    "^journalctl\\b",
    "^ss\\s+-",
    "^curl\\b",
    "^openssl\\s+(s_client|x509)\\b",
    "^(echo|sort|uniq|cut|tr|jq|column|true)\\b",
    "^sed\\s+-n\\s+(['\"]?)(\\d+(,\\d+)?|/[^/'\"]*/)p\\1(\\s|$)",
    "^cd\\s+\\S+$"
  ],
  "ssh_rahasia": "\\.env\\b|id_[rde]\\w*sa|\\.pem\\b|\\.key\\b|secret|passw|token|credential|environ\\b",

  "lokal_netral": ["cd", "echo", "tail", "head", "grep", "wc", "sort", "uniq", "cut", "jq", "cat", "ls", "tr", "sleep", "true", "date", "column"]
